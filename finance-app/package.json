{
  "name": "finance-app",
  "version": "1.0.0",
  "description": "Personal Finance Dashboard - Track expenses, budgets, and financial goals",
  "main": "node_modules/expo/AppEntry.js",
  "expo": {
    "name": "Finance Tracker",
    "slug": "finance-tracker",
    "privacy": "public",
    "owner": "delongkevin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10B981"
    },
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.delongkevin.financetracker"
    },
    "android": {
      "versionCode": 1,
      "package": "com.delongkevin.financetracker",
      "permissions": []
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "finance-tracker-project"
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "eas:build:android": "eas build --platform android",
    "eas:build:ios": "eas build --platform ios",
    "eas:build:all": "eas build --platform all"
  },
  "dependencies": {
    "expo": "~50.0.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "react-native-screens": "^3.28.0",
    "react-native-safe-area-context": "^4.8.0",
    "axios": "^1.6.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.6.0",
    "moment": "^2.29.4",
    "react-native-svg": "^14.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.3.0"
  },
  "author": "Kevin Douglas Delong",
  "license": "MIT"
}
