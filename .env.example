# Copy to .env.local for local development. Set the same keys in Netlify site settings for deploys.

# Neon Postgres connection string used by the visitor-logging Netlify Functions.
NEON_DATABASE_URL=

# Secret used to hash visitor IPs before storing them (never store raw IPs). Use a long random string.
IP_HASH_SALT=

# Bearer token required to call the get-visits admin function / view /admin/visits.
ADMIN_API_TOKEN=

# Blog editor uses this private token and Neon database.
BLOG_ADMIN_TOKEN=
# Initialize the blog_posts table with: NEON_DATABASE_URL=... node scripts/init-blog-schema.mjs

# Optional comment email notifications via Resend. Comments still work without these values.
RESEND_API_KEY=
COMMENT_NOTIFICATION_EMAIL=delong.kevin@gmail.com
EMAIL_FROM=

# Set to "true" to enable client-side visit logging (opt-in, disabled by default).
NEXT_PUBLIC_ENABLE_VISIT_LOGGING=false

# Optional: enables the Plausible analytics script when set to your domain.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
