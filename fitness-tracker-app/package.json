{
  "name": "fitness-tracker-app",
  "version": "1.0.0",
  "description": "Fitness Tracker - Track workouts, health metrics, and achieve your goals",
  "main": "node_modules/expo/AppEntry.js",
  "expo": {
    "name": "Fitness Tracker",
    "slug": "fitness-tracker",
    "privacy": "public",
    "owner": "delongkevin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1565C0"
    },
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.delongkevin.fitnesstracker"
    },
    "android": {
      "versionCode": 1,
      "package": "com.delongkevin.fitnesstracker",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.BODY_SENSORS"
      ]
    },
    "plugins": [
      "expo-location",
      "expo-health"
    ],
    "extra": {
      "eas": {
        "projectId": "fitness-tracker-project"
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "eas:build:android": "eas build --platform android",
    "eas:build:ios": "eas build --platform ios",
    "eas:build:all": "eas build --platform all"
  },
  "dependencies": {
    "expo": "~50.0.0",
    "expo-camera": "~14.1.0",
    "expo-location": "~16.5.0",
    "expo-health": "~3.0.0",
    "expo-notifications": "~0.27.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-svg": "^14.0.0",
    "react-navigation": "^6.1.7",
    "react-navigation-bottom-tabs": "^6.5.0",
    "react-navigation-stack": "^6.3.17",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "react-native-screens": "^3.28.0",
    "react-native-safe-area-context": "^4.8.0",
    "axios": "^1.6.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.6.0",
    "react-native-svg-charts": "^5.4.0",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.3.0"
  },
  "author": "Kevin Douglas Delong",
  "license": "MIT"
}
